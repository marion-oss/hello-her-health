{
  "expo": {
    "name": "Anoqi",
    "slug": "anoqi",
    "scheme": "anoqi",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "health.anoqi.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "health.anoqi.app",
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-font",
      "expo-splash-screen",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
