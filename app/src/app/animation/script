<script>
// ─── TYPEWRITER ───
const speeches = [
  { text: "Guten Tag. Ich bin FELIX.", pause: 900 },
  { text: "Dein digitaler Büroassistent.", pause: 800 },
  { text: "Du sprichst. Ich erledige. Du gibst frei.", pause: 1200 },
  { text: "Was soll ich heute für dich tun?", pause: 0 }
];

let speechIdx = 0;
let charIdx = 0;
let isTyping = false;
const speechEl = document.getElementById('speechText');
const cursorEl = document.getElementById('cursor');
const orbEl = document.getElementById('mainOrb');
const waveEl = document.getElementById('waveform');
const ctaEl = document.getElementById('ctaSection');

function typeNext() {
  if (speechIdx >= speeches.length) {
    ctaEl.classList.add('visible');
    cursorEl.style.display = 'none';
    return;
  }

  const current = speeches[speechIdx];
  isTyping = true;
  orbEl.classList.add('speaking');
  waveEl.classList.add('active');

  function typeChar() {
    if (charIdx < current.text.length) {
      speechEl.textContent = current.text.slice(0, charIdx + 1);
      charIdx++;
      setTimeout(typeChar, charIdx < 3 ? 60 : 38 + Math.random() * 30);
    } else {
      isTyping = false;
      orbEl.classList.remove('speaking');
      waveEl.classList.remove('active');
      charIdx = 0;
      speechIdx++;

      if (current.pause > 0) {
        setTimeout(() => {
          speechEl.textContent = '';
          typeNext();
        }, current.pause);
      } else {
        typeNext();
      }
    }
  }

  typeChar();
}

setTimeout(typeNext, 800);

// ─── TASK HANDLER ───
function handleTask(type) {
  const overlay = document.getElementById('resultOverlay');
  const proc = document.getElementById('processingView');
  const content = document.getElementById('resultContent');
  const msg = document.getElementById('processingMsg');

  overlay.classList.add('open');
  proc.classList.remove('hidden');
  content.classList.add('hidden');
  document.getElementById('approveBtn').style.display = 'flex';
  document.getElementById('approveBtn').textContent = '✓ Freigeben & Senden';

  const messages = {
    rechnung: 'Rechnung wird erstellt...',
    angebot: 'Angebot wird ausgearbeitet...',
    anruf: 'Gespräch wird aufbereitet...',
    termin: 'Kalender wird geprüft...'
  };
  msg.textContent = messages[type];

  setTimeout(() => {
    proc.classList.add('hidden');
    content.classList.remove('hidden');
    renderResult(type);
  }, 2200);
}

function closeResult() {
  document.getElementById('resultOverlay').classList.remove('open');
}

function showApproved() {
  const btn = document.getElementById('approveBtn');
  btn.textContent = '✅ Gesendet!';
  btn.style.background = '#16a34a';
  setTimeout(closeResult, 1400);
}

// ─── RENDER RESULTS ───
function renderResult(type) {
  const speech = document.getElementById('felixSpeech');
  const doc = document.getElementById('docWrap');
  const status = document.getElementById('resultStatus');

  if (type === 'rechnung') {
    status.textContent = 'Rechnung erstellt ✓';
    speech.textContent = '„Ich hab die Rechnung für Thomas Müller fertig – 1.960 Euro brutto, GoBD-konform, dein Logo drauf. Willst du sie direkt rausschicken?"';
    doc.innerHTML = invoiceHTML();
  } else if (type === 'angebot') {
    status.textContent = 'Angebot erstellt ✓';
    speech.textContent = '„Das Angebot für Familie Schreiber ist fertig – Badezimmer-Sanierung, drei Optionen, 4.200 bis 6.800 Euro. Soll ich es per E-Mail verschicken?"';
    doc.innerHTML = angebotHTML();
  } else if (type === 'anruf') {
    status.textContent = 'Anruf bearbeitet ✓';
    speech.textContent = '„Ich hab den Anruf von Frau Wagner angenommen – sie braucht einen neuen Hahn im Bad. Termin ist vorgemerkt für Mittwoch 14 Uhr. Passt dir das?"';
    doc.innerHTML = anrufHTML();
  } else if (type === 'termin') {
    status.textContent = 'Termin gebucht ✓';
    speech.textContent = '„Termin für Herrn Becker ist eingetragen – Donnerstag, 19. März, 9 Uhr. Bestätigung geht automatisch raus. Erinnerung 24h vorher auch."';
    doc.innerHTML = terminHTML();
  }
}

